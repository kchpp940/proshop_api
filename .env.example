# Django Configuration
SECRET_KEY=change_this_to_a_random_secret_key
ENVIRONMENT=development

# Site Configuration
DOMAIN=localhost:8000
SITE_NAME=Proshop

# Email Configuration (SMTP)
EMAIL_HOST_USER=your_email@gmail.com
EMAIL_HOST_PASSWORD=your_app_password

# Google OAuth2 (Optional)
SOCIAL_AUTH_GOOGLE_OAUTH2_KEY=your_google_oauth_client_id
SOCIAL_AUTH_GOOGLE_OAUTH2_SECRET=your_google_oauth_client_secret

# --- Production Only (Azure) ---

# PostgreSQL Database
APP_DB_NAME=proshop
POSTGRES_ADMIN_USER=postgres
POSTGRES_ADMIN_PASSWORD=your_postgres_password
POSTGRES_HOST=localhost

# Azure Blob Storage
AZ_STORAGE_ACCOUNT_NAME=your_storage_account
AZ_STORAGE_CONTAINER=your_container
AZ_STORAGE_KEY=your_storage_account_key

# --- Optional (S3 / DigitalOcean Spaces) ---

# AWS_ACCESS_KEY_ID=your_access_key
# AWS_SECRET_ACCESS_KEY=your_secret_key
